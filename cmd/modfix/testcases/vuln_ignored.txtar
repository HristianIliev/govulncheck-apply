# A called golang.org/x/text vulnerability listed in govulncheck.ignore: it is
# reported, but the module is left alone.
-- main.go --
package main

import (
	"fmt"

	"golang.org/x/text/language"
)

func main() {
	fmt.Println(language.Parse("en-US"))
}
